# Project-specific environment variables for `tribe-y` (production).
# Loaded automatically by Firebase Functions on deploy.
#
# These are non-secret. Secrets go through `firebase functions:secrets:set`.

# Direct Cloud Run URL for the reviewerRpc function. Advertised in the
# A2A agent card as the JSON-RPC endpoint so clients bypass Firebase
# Hosting's 60-second edge timeout (which is too tight for `reviewFull`).
REVIEWER_RPC_ENDPOINT_OVERRIDE=https://reviewerrpc-dwap3scwgq-uc.a.run.app
