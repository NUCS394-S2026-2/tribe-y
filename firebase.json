{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/gemini/**", "function": "geminiMessages" },
      { "source": "/api/payment/**", "function": "confirmPayment" },
      { "source": "/api/code-review/**", "function": "fullCodeReview" },
      { "source": "/.well-known/agent.json", "function": "agentCard" },
      { "source": "/rpc", "function": "reviewerRpc" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
