## Interfaces

```typescript
// Recommended exact types to export / use

interface PaymentRequest {
  id: string;
  amount: number;
  currency: 'TESTNET';
  walletAddress: string; // or paymentURI
  status: 'pending' | 'confirmed' | 'failed' | 'expired';
  createdAt: string; // ISO 8601
  expiresAt: string; // ISO 8601
  txHash?: string;
  codeReviewId: string;
  receiptId?: string;
}

interface Receipt {
  id: string;
  codeReviewId: string;
  paymentRequestId: string;
  issuedAt: string; // ISO 8601
  issuer: 'tribe-y';
  metadata: Record<string, unknown>;
}
```

