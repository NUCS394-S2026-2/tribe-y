rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Code reviews: owner can create and read their own.
    // Client updates are blocked from modifying server-managed fields
    // (paymentStatus, fullReview, uid). Cloud Functions use Admin SDK
    // which bypasses these rules.
    match /codeReviews/{reviewId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.paymentStatus == 'unpaid';

      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['paymentStatus', 'fullReview', 'uid']);
    }

    // Transactions: owner can create (with uid validation) and read.
    // No client-side updates — transactions are immutable records.
    match /transactions/{txnId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
